# Copy to .env (same folder) and fill in. .env is gitignored; never commit it.
# The API server reads it on start, and so does `npm run history -w server`.

# Alpaca market data (your paid SIP + OPRA plan). Use a key pair from the
# Alpaca dashboard. This app only calls Alpaca's market-data API, never the
# trading API, but the keys themselves can trade: keep this file private.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# sip = consolidated feed (paid). iex = free single-exchange feed.
ALPACA_FEED=sip
# Request budget for history downloads. Basic plan: keep at or under 200.
# Paid plans can set it much higher (Algo Trader Plus allows 10,000/min);
# a higher value speeds up the backfill.
ALPACA_MAX_REQ_PER_MIN=180

# 1 = run the history sync every weekday evening (after 18:00 New York time)
# inside the API server. The first run is the full backfill and takes hours.
HISTORY_SYNC=0
# 0 = daily bars only: the nightly sync and `history all` skip the minute bars.
HISTORY_SYNC_MINUTE=1

# Live prices: with the Alpaca keys set, the API streams real-time trades for
# the watchlist, S&P 500, Nasdaq-100, sector ETFs and any ticker on screen, and
# minute bars for every other US ticker. 0 turns it off (REST snapshots, FMP and
# Stooq answer instead).
LIVE_STREAM=1
# 1 = stream every trade in the market instead (a much heavier feed at the open).
LIVE_ALL_TRADES=0
# Overnight (20:00–04:00 New York) prices from Alpaca's Blue Ocean ATS feed, on a
# second stream connection. 0 turns it off.
LIVE_OVERNIGHT=1

# Scan engine: 0 turns off the stock and option scorecards, the hourly bars and
# the ideas screens. The options sweep and stream are separate. See docs/scan-engine.md.
SCAN_ENABLED=1
# Live option quotes (OPRA) for held contracts and the ATM call and put of each
# universe underlying. 0 turns it off; the 5-minute sweep still runs.
# See docs/options-data.md.
OPTIONS_STREAM=1
# Alpaca options feed for the stream. opra is the default.
ALPACA_OPTIONS_FEED=opra
# Most option contracts the stream subscribes to (OPRA allows 1,000).
OPTIONS_STREAM_MAX=1000
# Shortest expiry, in days, the streamed ATM pair may use.
OPTIONS_STREAM_MIN_DTE=7
# Longest expiry, in days, the 5-minute sweep requests.
OPTIONS_SWEEP_MAX_DTE=60
# Strikes the sweep requests, as a fraction of the price on each side (0.15 = ±15%).
OPTIONS_SWEEP_STRIKE_RANGE=0.15
# 0 turns off the 5-minute option-chain sweep (on by default when Alpaca is configured).
OPTIONS_SWEEP=1
# Parallel chain requests during a sweep.
OPTIONS_SWEEP_CONCURRENCY=4
# 0 turns off the background IV-history backfill that seeds IV rank and
# percentile from past option bars (on by default when Alpaca is configured).
OPTIONS_BACKFILL=1
# Pin the Alpaca trading API base (market calendar and open interest) instead of
# auto-detecting live then paper. Leave blank to auto-detect.
ALPACA_TRADING_BASE=
# Risk-free rate for the option model (annual, 0.04 = 4%).
RISK_FREE_RATE=0.04
# Days of option minute bars to keep. Older bars are pruned every 6 hours.
OPTION_BARS_RETENTION_DAYS=90

# Analysis agents (see docs/agents.md). 0 turns off the schedules and the
# analyse and run routes.
AGENTS_ENABLED=1
# The most the agents may spend in one trading day, in US dollars. Enforced in code.
AGENTS_DAILY_BUDGET_USD=5
# Analyses that run at once.
AGENTS_CONCURRENCY=2
# Model for the macro, bull, bear and brief agents.
AGENTS_MODEL=claude-sonnet-5-5
# Model for the judge, which writes the thesis.
AGENTS_JUDGE_MODEL=claude-opus-5-5

# SEC EDGAR (insider trades, filings, shares outstanding and SIC sectors) and the
# BLS release schedule require a contact email in every request's User-Agent.
# Use your own; those features are skipped without it.
SEC_EDGAR_CONTACT=

# Optional: Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs).
# Unlocks quote fundamentals (P/E, EPS, beta, 52-week range, dividend yield),
# foreign listings and indices, FMP sectors and market caps for the heatmap and
# screener, the earnings calendar and history (503 "needs FMP_API_KEY" without
# it), and forecast/previous/actual on the economic calendar. Starter covers US
# listings (quarterly statements, TTM ratios; analyst estimates annual only);
# non-US exchanges need Premium (UK, Canada) or Ultimate (global).
FMP_API_KEY=
# FMP calls per minute the app may make: 300 Starter (default), 750 Premium,
# 3000 Ultimate. The BMO/AMC column on the earnings calendar is derived from
# FMP press releases and makes about two calls per symbol a month.
FMP_MAX_REQ_PER_MIN=300

# Optional: FRED API key (free, https://fred.stlouisfed.org/docs/api/api_key.html).
# Adds FRED's release dates to the economic calendar. Yields and VIX don't need it.
FRED_API_KEY=

# Claude API key. Used by the AI assistant and the analysis agents. With a key,
# agent runs are billed to that API account. Without one, the agents use the
# Claude account you are logged in with here, and the costs shown are notional.
ANTHROPIC_API_KEY=
