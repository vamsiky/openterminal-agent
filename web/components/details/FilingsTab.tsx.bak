"use client";

import { useState } from "react";
import { fmt, fmtBig } from "../../lib/api";
import PillTabs from "../ui/PillTabs";
import { Async, DataTable, ExtLink, dstr, useGet, useResearch, type Column } from "./shared";

const SUBS = [
  { id: "sec", label: "SEC filings" },
  { id: "press", label: "Press releases" },
  { id: "form4", label: "Insider filings" },
];

type Filing = { filingDate: string; formType: string; link: string | null; finalLink: string | null };
type Release = { publishedDate: string; title: string; publisher: string | null; site: string | null; url: string | null };
export type InsiderTx = {
  filingDate: string; transactionDate: string; ownerName: string; ownerTitle: string | null; isDirector: boolean; isTenPercentOwner: boolean;
  transactionCode: string; acquiredDisposed: "A" | "D" | null; shares: number | null; pricePerShare: number | null; value: number | null;
};

const FORMS: Record<string, string> = {
  "10-K": "Annual report", "10-Q": "Quarterly report", "8-K": "Current report (material event)", "4": "Insider transaction", "3": "Insider initial ownership",
  "5": "Insider annual statement", "144": "Planned insider sale", "DEF 14A": "Proxy statement", "S-8": "Employee stock plan registration", "SC 13G": "5% holder report",
  "SC 13D": "5% holder report (active)", "13F-HR": "Institutional holdings report", "424B2": "Prospectus supplement", "S-3": "Securities registration",
};

// SEC's single-letter transaction codes, the ones that actually show up in practice.
export const CODE_LABEL: Record<string, string> = {
  P: "Open market buy", S: "Open market sale", A: "Grant/award", M: "Option exercise", G: "Gift", F: "Tax withholding", C: "Conversion", D: "Disposition to issuer",
};
export const roleOf = (t: InsiderTx) => t.ownerTitle ?? (t.isDirector ? "Director" : t.isTenPercentOwner ? "10%+ owner" : "—");
export const sideCls = (t: InsiderTx) => (t.acquiredDisposed === "A" ? "up" : t.acquiredDisposed === "D" ? "down" : "dim");

function Sec({ symbol }: { symbol: string }) {
  const q = useResearch<Filing[]>(symbol, "filings", "?limit=25");
  const cols: Array<Column<Filing>> = [
    { label: "Filed", left: true, cls: () => "dim", cell: (f) => dstr(f.filingDate) },
    { label: "Form", left: true, cls: () => "amber", cell: (f) => <ExtLink href={f.finalLink ?? f.link}>{f.formType}</ExtLink> },
    { label: "What it is", left: true, cell: (f) => FORMS[f.formType] ?? "SEC filing" },
  ];
  return (
    <Async q={q} what="SEC filings" symbol={symbol} empty={`No SEC filings found for ${symbol}.`}>
      {(rows) => <DataTable columns={cols} rows={rows} minWidth={360} rowKey={(f, i) => `${f.filingDate}-${f.formType}-${i}`} />}
    </Async>
  );
}

function Press({ symbol }: { symbol: string }) {
  const q = useResearch<Release[]>(symbol, "press-releases", "?limit=25");
  const cols: Array<Column<Release>> = [
    { label: "Date", left: true, cls: () => "dim", cell: (p) => dstr(p.publishedDate) },
    { label: "Release", left: true, cell: (p) => <ExtLink href={p.url}>{p.title}</ExtLink> },
    { label: "Wire", left: true, cls: () => "dim", cell: (p) => p.publisher ?? p.site ?? "—" },
  ];
  return (
    <Async q={q} what="press releases" symbol={symbol}>
      {(rows) => <DataTable columns={cols} rows={rows} minWidth={420} rowKey={(p, i) => `${p.publishedDate}-${i}`} />}
    </Async>
  );
}

function InsiderFilings({ symbol }: { symbol: string }) {
  const q = useGet<InsiderTx[]>(`insider:${symbol}`, `/api/insider/${encodeURIComponent(symbol)}`);
  const cols: Array<Column<InsiderTx>> = [
    { label: "Filed", left: true, cls: () => "dim", cell: (t) => dstr(t.filingDate) },
    { label: "Insider", left: true, cell: (t) => t.ownerName },
    { label: "What it is", left: true, cls: sideCls, cell: (t) => `Form 4 · ${CODE_LABEL[t.transactionCode] ?? t.transactionCode}` },
    { label: "Shares", cell: (t) => fmtBig(t.shares) },
    { label: "Value", cls: () => "dim", cell: (t) => (t.value == null ? "—" : `$${fmtBig(t.value)}`) },
  ];
  return (
    <Async q={q} what="insider filings (Form 4)" symbol={symbol} empty={`No recent insider filings (Form 4) for ${symbol}.`}>
      {(rows) => <DataTable columns={cols} rows={rows} rowKey={(t, i) => `${t.filingDate}-${t.ownerName}-${i}`} />}
    </Async>
  );
}

export default function FilingsTab({ symbol }: { symbol: string }) {
  const [sub, setSub] = useState("sec");
  return (
    <>
      <PillTabs tabs={SUBS} value={sub} onChange={setSub} size="sm" ariaLabel="Filings sections" />
      {sub === "sec" && <Sec symbol={symbol} />}
      {sub === "press" && <Press symbol={symbol} />}
      {sub === "form4" && <InsiderFilings symbol={symbol} />}
    </>
  );
}

export { fmt };
